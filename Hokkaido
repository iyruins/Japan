/* ===== 以下是程式，不需修改 ===== */
const $=s=>document.querySelector(s),E=s=>String(s??"").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const M=q=>"https://www.google.com/maps/search/?api=1&query="+encodeURIComponent(q);
const ld=(k,d)=>{try{return JSON.parse(localStorage.getItem(k))??d}catch(e){return d}};
const sv=(k,v)=>{try{localStorage.setItem(k,JSON.stringify(v));return true}catch(e){alert("儲存空間已滿，請刪除部分照片。");return false}};
const views=[["home","首頁"],["trip","行程"],["food","餐廳"],["budget","預算"],["photos","相簿"],["list","清單"],["weather","天氣"]];
$("#nav").innerHTML=views.map(v=>`<a href="#${v[0]}" data-v="${v[0]}">${v[1]}</a>`).join("");
$("#dayCards").innerHTML=DATA.days.map(d=>`<a href="#day${d.n}"><small>DAY ${d.n} · ${d.date}</small><h3>${E(d.title)}</h3><div style="font-size:13px;color:var(--tan)">${E(d.stay.n)}</div></a>`).join("");
$("#flags").innerHTML=DATA.flags.map(f=>`<div class="warn">${E(f)}</div>`).join("");
$("#chips").innerHTML=DATA.days.map(d=>`<a href="#day${d.n}" data-d="${d.n}">DAY ${d.n}</a>`).join("");
function showDay(n){const d=DATA.days[n-1];
 const stops=d.ev.filter(e=>e.q).map(e=>e.q);
 const route=stops.length>1?`https://www.google.com/maps/dir/?api=1&travelmode=driving&origin=${encodeURIComponent(stops[0])}&destination=${encodeURIComponent(stops[stops.length-1])}&waypoints=${encodeURIComponent(stops.slice(1,-1).join("|"))}`:"";
 $("#day").innerHTML=`<h2>DAY ${d.n} · ${d.date}</h2><p class="sub">${E(d.title)}</p>
 <div class="tl">${d.ev.map(e=>`<div class="ev"><div class="t">${e.t}</div><b>${E(e.n)}</b>${e.d?`<p>${E(e.d)}</p>`:""}<div>${e.q?`<a class="btn" href="${M(e.q)}" target="_blank" rel="noopener">地圖與導航</a>`:""}</div>${e.drive?`<div class="drive">${E(e.drive)}</div>`:""}</div>`).join("")}</div>
 ${route?`<a class="btn" href="${route}" target="_blank" rel="noopener">查看當日行車路線</a>`:""}
 <div class="box"><h3>住宿</h3><p>${E(d.stay.n)} ${d.stay.url?`<a class="btn" href="${E(d.stay.url)}" target="_blank" rel="noopener">Airbnb 頁面</a>`:""} ${d.stay.q?`<a class="btn" href="${M(d.stay.q)}" target="_blank" rel="noopener">地圖</a>`:""}</p></div>
 <div class="box"><h3>注意事項</h3><ul class="safe">${d.notes.map(x=>`<li>${E(x)}</li>`).join("")}</ul></div>
 ${EXTRA[n]?EXTRA[n]():""}${(IMG["d"+n]||[]).length?`<div class="box"><h3>照片</h3><div class="gal">${IMG["d"+n].map((s,i)=>`<img src="${s}" alt="DAY ${n} 照片 ${i+1}">`).join("")}</div></div>`:""}<div class="warn" style="margin-top:12px">所有時間與路程取自 PDF；景點地址請在 Google Maps 頁面查看，本站不自行填寫地址。</div>`}
$("#foodList").innerHTML=DATA.food.map(f=>`<div class="box"><small style="color:var(--tan)">${f.s}</small><h3 style="font-size:22px">${E(f.n)}</h3><p>${E(f.a)}</p><p class="safe">營業時間：${E(f.h||"待確認")}<br>公休日：${E(f.c||"待確認")}<br>價格：${E(f.p||"待確認")}</p><a class="btn" href="${M(f.q)}" target="_blank" rel="noopener">Google Maps</a></div>`).join("");
/* weather */
const W=[["札幌",43.06,141.35],["小樽",43.19,140.99],["旭川",43.77,142.36],["美瑛",43.59,142.47],["新千歲機場",42.79,141.69]];
$("#wx").innerHTML=W.map(w=>`<div class="box"><h3>${w[0]}</h3><p><a href="https://www.windy.com/${w[1]}/${w[2]}?${w[1]},${w[2]},9" target="_blank" rel="noopener">Windy 降雪、風速</a><br><a href="https://www.google.com/search?q=${encodeURIComponent(w[0]+" 天氣")}" target="_blank" rel="noopener">天氣預報</a></p></div>`).join("")+`<div class="box"><h3>警報與路況</h3><p><a href="https://www.jma.go.jp/bosai/warning/" target="_blank" rel="noopener">日本氣象廳 警報</a><br><a href="https://tenki.jp/" target="_blank" rel="noopener">tenki.jp</a></p></div>`;
/* budget */
const CATS=["機票","租車","住宿","ETC／高速公路費","油錢","餐飲","購物","景點門票","其他"];
let B=ld("hk_budget",{rate:0.21,total:0,rows:[]});if(!B.names)B.names=[B.pa||"我",B.pb||"男友","朋友 C","朋友 D"];
const tw=r=>r.cur==="JPY"?r.amt*B.rate:r.amt,f0=n=>Math.round(n).toLocaleString();
const opt=a=>a.map(x=>`<option>${E(x)}</option>`).join("");
function bud(){sv("hk_budget",B);$("#rate").value=B.rate;$("#total").value=B.total;B.names.forEach((n,i)=>$("#n"+i).value=n);
 $("#nc").innerHTML=opt(CATS);$("#np").innerHTML=opt(B.names);
 const sum=B.rows.reduce((s,r)=>s+tw(r),0),by=n=>B.rows.filter(r=>r.p===n).reduce((s,r)=>s+tw(r),0);
 $("#sum").innerHTML=`<div>總花費 TWD<b>${f0(sum)}</b></div><div>預算差額<b>${B.total?f0(B.total-sum):"—"}</b></div>${B.names.map(n=>`<div>${E(n)} 已付<b>${f0(by(n))}</b></div>`).join("")}`+CATS.map(c=>{const v=B.rows.filter(r=>r.c===c).reduce((s,r)=>s+tw(r),0);return v?`<div>${c}<b>${f0(v)}</b></div>`:""}).join("");
 $("#rows").innerHTML=B.rows.length?B.rows.map((r,i)=>`<tr><td><select data-i="${i}" data-k="c">${CATS.map(c=>`<option ${c===r.c?"selected":""}>${c}</option>`).join("")}</select></td><td><input data-i="${i}" data-k="d" value="${E(r.d)}"></td><td><input type="number" data-i="${i}" data-k="amt" value="${r.amt}" style="width:90px"></td><td><select data-i="${i}" data-k="cur"><option ${r.cur==="JPY"?"selected":""}>JPY</option><option ${r.cur==="TWD"?"selected":""}>TWD</option></select></td><td><select data-i="${i}" data-k="p">${B.names.map(p=>`<option ${p===r.p?"selected":""}>${E(p)}</option>`).join("")}</select></td><td>${f0(tw(r))}</td><td><button class="x" data-del="${i}">刪除</button></td></tr>`).join(""):`<tr><td colspan="7" class="empty">還沒有支出，從上方新增第一筆。</td></tr>`}
$("#rate").onchange=e=>{B.rate=+e.target.value||0;bud()};$("#total").onchange=e=>{B.total=+e.target.value||0;bud()};
[0,1,2,3].forEach(i=>$("#n"+i).onchange=e=>{const o=B.names[i],v=e.target.value.trim()||o;B.rows.forEach(r=>{if(r.p===o)r.p=v});B.names[i]=v;bud()});
$("#add").onclick=()=>{const a=+$("#na").value;if(!a)return alert("請輸入金額");B.rows.push({c:$("#nc").value,d:$("#nd").value,amt:a,cur:$("#ncur").value,p:$("#np").value});$("#nd").value="";$("#na").value="";bud()};
$("#rows").onchange=e=>{const t=e.target,i=t.dataset.i;if(i==null)return;B.rows[i][t.dataset.k]=t.dataset.k==="amt"?+t.value||0:t.value;bud()};
$("#rows").onclick=e=>{const i=e.target.dataset.del;if(i!=null&&confirm("刪除這筆支出？")){B.rows.splice(i,1);bud()}};
/* photos */
let P=ld("hk_photos",{}),pd=1;
$("#pchips").innerHTML=DATA.days.map(d=>`<a href="#" data-p="${d.n}">DAY ${d.n}</a>`).join("");
function wall(){document.querySelectorAll("#pchips a").forEach(a=>a.classList.toggle("on",+a.dataset.p===pd));const L=P[pd]||[];
 $("#wall").innerHTML=L.length?L.map((s,i)=>`<div><img src="${s}" alt="DAY ${pd} 照片 ${i+1}"><button class="x" data-rm="${i}" style="background:var(--card)">刪除</button></div>`).join(""):`<div class="empty" style="column-span:all">DAY ${pd} 還沒有照片，點上方選擇檔案上傳。</div>`}
$("#pchips").onclick=e=>{e.preventDefault();if(e.target.dataset.p){pd=+e.target.dataset.p;wall()}};
$("#up").onchange=async e=>{for(const f of e.target.files){const s=await new Promise(r=>{const im=new Image,u=URL.createObjectURL(f);im.onload=()=>{const k=Math.min(1,900/Math.max(im.width,im.height)),c=document.createElement("canvas");c.width=im.width*k;c.height=im.height*k;c.getContext("2d").drawImage(im,0,0,c.width,c.height);URL.revokeObjectURL(u);r(c.toDataURL("image/jpeg",.72))};im.onerror=()=>r(null);im.src=u});if(s){(P[pd]=P[pd]||[]).push(s);if(!sv("hk_photos",P)){P[pd].pop();break}}}e.target.value="";wall()};
$("#wall").onclick=e=>{if(e.target.tagName==="IMG"){$("#lb img").src=e.target.src;$("#lb").classList.add("on")}else if(e.target.dataset.rm!=null&&confirm("刪除這張照片？")){P[pd].splice(e.target.dataset.rm,1);sv("hk_photos",P);wall()}};
$("#day").onclick=e=>{if(e.target.tagName==="IMG"){$("#lb img").src=e.target.src;$("#lb").classList.add("on")}};
document.querySelector(".hero").style.backgroundImage="linear-gradient(#0000 40%,#2a201a99),url("+IMG.hero+")";
$("#lb").onclick=()=>$("#lb").classList.remove("on");
/* checklist */
let C=ld("hk_check",null);if(!C){C={};for(const g in LISTS)C[g]=LISTS[g].map(t=>({t,d:false}))}
$("#lg").innerHTML=opt(Object.keys(C));
function chk(){sv("hk_check",C);$("#lists").innerHTML=Object.keys(C).map(g=>`<div class="box ck"><h3>${E(g)}</h3>${C[g].map((x,i)=>`<label class="${x.d?"done":""}"><input type="checkbox" data-g="${E(g)}" data-i="${i}" ${x.d?"checked":""}><span style="flex:1">${E(x.t)}</span><button class="x" data-g="${E(g)}" data-rm="${i}">刪除</button></label>`).join("")}</div>`).join("")}
$("#lists").onchange=e=>{const t=e.target;if(t.type==="checkbox"){C[t.dataset.g][t.dataset.i].d=t.checked;chk()}};
$("#lists").onclick=e=>{const t=e.target;if(t.dataset.rm!=null){e.preventDefault();C[t.dataset.g].splice(t.dataset.rm,1);chk()}};
$("#la").onclick=()=>{const v=$("#li").value.trim();if(!v)return;C[$("#lg").value].push({t:v,d:false});$("#li").value="";chk()};
/* routing: only #name hashes */
function route(){let h=location.hash.slice(1)||"home",m=/^day([1-6])$/.exec(h),v=m?"trip":h;if(!views.some(x=>x[0]===v)){v="home"}
 document.querySelectorAll("section").forEach(s=>s.classList.toggle("on",s.id===v));
 document.querySelectorAll("#nav a").forEach(a=>a.classList.toggle("on",a.dataset.v===v));
 if(v==="trip"){const n=m?+m[1]:1;showDay(n);document.querySelectorAll("#chips a").forEach(a=>a.classList.toggle("on",+a.dataset.d===n))}
 window.scrollTo(0,0)}
addEventListener("hashchange",route);bud();wall();chk();route();
</script></body></html>
